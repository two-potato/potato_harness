{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "task_id",
    "task_revision",
    "repository_id",
    "acceptance_ids",
    "commit",
    "kind",
    "check_id",
    "source",
    "issuer_id",
    "attestation_ref",
    "run_id",
    "result",
    "artifact_digest",
    "created_at",
    "policy_version"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.1"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_revision": {
      "type": "integer",
      "minimum": 0
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "value"
      ],
      "properties": {
        "hash_algorithm": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hash_algorithm": {
                "const": "sha1"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hash_algorithm": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "kind": {
      "enum": [
        "test",
        "ci_check",
        "independent_review",
        "security_review",
        "contract_check",
        "build",
        "smoke",
        "research",
        "basic_review",
        "rollback_plan"
      ]
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "attestation_ref": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIPPED",
        "ERROR",
        "UNKNOWN"
      ]
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_actor": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_session": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/schemas/evidence-record.schema.json",
  "title": "evidence-record"
}
