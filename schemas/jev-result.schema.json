{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_revision",
    "phase",
    "idempotency_key",
    "verdict",
    "gaps",
    "authoritative",
    "attempt_state"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_revision": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "enum": [
        "PREFLIGHT",
        "COMPLETION"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "CLEAR",
        "REVIEW_RECOMMENDED",
        "INCOMPLETE",
        "UNAVAILABLE"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "authoritative": {
      "const": false
    },
    "attempt_state": {
      "enum": [
        "RESERVED",
        "SENT",
        "RESULT",
        "UNAVAILABLE",
        "UNKNOWN"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/schemas/jev-result.schema.json",
  "title": "jev-result"
}
