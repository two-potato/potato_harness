{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "row_version",
    "state",
    "last_event_seq",
    "task_graph_digest",
    "target_commit",
    "lease_refs",
    "pending_effect_ids",
    "evidence_digest",
    "budget_id"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "row_version": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "NEW",
        "CLASSIFIED",
        "PLANNED",
        "ASSIGNED",
        "EXECUTING",
        "REVIEWING",
        "VERIFYING",
        "COMPLETION_AUDITING",
        "REREVIEW",
        "REPAIR",
        "ACCEPTED",
        "DONE",
        "BLOCKED",
        "NEEDS_HUMAN_APPROVAL",
        "CANCELLED"
      ]
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "task_graph_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "value"
      ],
      "properties": {
        "hash_algorithm": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hash_algorithm": {
                "const": "sha1"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hash_algorithm": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "lease_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "pending_effect_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "budget_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/schemas/checkpoint.schema.json",
  "title": "checkpoint"
}
