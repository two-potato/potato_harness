{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "repository_id",
    "task_id",
    "task_revision",
    "worker_session_id",
    "workspace_id",
    "resources",
    "mode",
    "fencing_token",
    "expires_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.1"
    },
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_revision": {
      "type": "integer",
      "minimum": 0
    },
    "worker_session_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "key"
        ],
        "properties": {
          "kind": {
            "enum": [
              "path",
              "logical"
            ]
          },
          "key": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\*?]).+$"
          }
        }
      },
      "minItems": 1
    },
    "mode": {
      "enum": [
        "exclusive_write"
      ]
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUSPECT",
        "EXPIRED",
        "REVOKED"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/schemas/lease.schema.json",
  "title": "lease"
}
