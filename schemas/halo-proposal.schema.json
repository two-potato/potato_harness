{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "source_trace_set_digest",
    "baseline_commit",
    "policy_version",
    "target_component",
    "hypothesis",
    "candidate_diff_digest",
    "evaluator_digest",
    "train_split_digest",
    "eval_split_digest",
    "holdout_split_digest",
    "train_eval_run_id",
    "holdout_eval_run_id",
    "metrics_before",
    "metrics_after",
    "safety_regressions",
    "status",
    "rollback_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "source_trace_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseline_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "value"
      ],
      "properties": {
        "hash_algorithm": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hash_algorithm": {
                "const": "sha1"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "hash_algorithm": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "target_component": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "candidate_diff_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluator_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "train_split_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eval_split_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "holdout_split_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "train_eval_run_id": {
      "type": "string",
      "minLength": 1
    },
    "holdout_eval_run_id": {
      "type": "string",
      "minLength": 1
    },
    "metrics_before": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "sample_size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "sample_size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1
    },
    "metrics_after": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "sample_size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "sample_size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 1
    },
    "safety_regressions": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "PROPOSED",
        "REJECTED",
        "HOLD",
        "APPROVED"
      ]
    },
    "human_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "rollback_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/schemas/halo-proposal.schema.json",
  "title": "halo-proposal"
}
